# Modelo das variáveis de ambiente. NENHUM VALOR REAL AQUI.
# Copie para `.env` e preencha. O `.env` está no .gitignore e nunca é commitado.
#
# CLAUDE.md §4: "Nenhum segredo no código ou no repositório. Só em variáveis de
# ambiente." Este arquivo existe para dizer QUAIS variáveis existem, nunca os
# valores.

# --- Banco (Supabase) ------------------------------------------------------
# TRÊS URLs, e a separação é segurança, não organização (CLAUDE.md §9).
# Mesmo host, mesmo banco. O que muda é o USUÁRIO de cada uma.
#
# Nenhuma conexão em execução pode ignorar RLS. `postgres` ignora, por isso ele
# aparece só na URL das migrations, que não roda no produto.
#
# No pooler do Supabase o usuário leva o projeto junto:  usuario.projeto
# A senha, se tiver caractere especial, precisa ir codificada para URL.

# Domínio. Papel `fretigate_app`: enxerga só a empresa do contexto, sem DELETE,
# e não alcança as tabelas de autenticação. Porta 6543, pool de transação.
DATABASE_URL=

# Autenticação. Papel `fretigate_auth`: só as tabelas do Better Auth e
# `usuario`. Não enxerga nenhuma tabela de domínio. Porta 6543.
# Usada exclusivamente por `src/lib/auth`.
AUTH_DATABASE_URL=

# Migrations. Papel `postgres`: dono das tabelas, precisa criar e alterar.
# NÃO é usada pela aplicação em execução. Porta 5432, modo sessão — migration
# precisa de sessão, e o pool de transação não garante sessão.
DIRECT_URL=

# --- Storage (Supabase) -----------------------------------------------------
# Comprovante de embarque (item 5, Tarefa 4). Não é o Postgres acima — é a API
# de arquivos do mesmo projeto Supabase, para o balde privado `comprovantes`
# (migration `20260825060000_balde_comprovantes_storage`).
#
# Projeto por ambiente, mesma tabela de `CLAUDE.md` §5 ("Ambientes"):
# desenvolvimento é `ysldmzvszjxdgcbtaurh`, teste (CI) é `qutzsvrkaqvpluqxbhmp`.

# URL da API do projeto Supabase do ambiente.
#   https://<projeto>.supabase.co
SUPABASE_URL=

# A chave `service_role` do projeto — IGNORA RLS por atributo, é o "papel
# embutido" descrito no CLAUDE.md §4 ("Os papéis embutidos do Supabase").
# NUNCA vai ao navegador, nunca em log. Usada só em
# `src/lib/servicos/comprovantes.ts`, para gravar/ler o balde de
# comprovantes depois de o servidor já ter conferido posse do frete.
#
# Fica no painel do Supabase: Project Settings → API → Project API keys →
# `service_role` (chamada "secret" nas versões mais novas do painel).
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail transacional (Resend) ------------------------------------------
# Três momentos, e só esses três: recuperação de senha, verificação de e-mail
# e ativação de assinatura (item 13 — quem paga pelo Fluxo B só recebe o link
# que cria a conta por este e-mail). Convite de usuário NÃO manda e-mail — é
# sempre por WhatsApp, envio manual (item 10, Tarefa 4). Não é marketing — não
# compartilha reputação com mala direta futura.
#
# O envio sai de um SUBDOMÍNIO (`envio.fretigate.com`), não do domínio
# principal: assim um problema de reputação em mala direta futura não derruba a
# recuperação de senha.
RESEND_API_KEY=

# De onde a mensagem SAI. Fica no subdomínio de envio.
#   contato@envio.fretigate.com
EMAIL_REMETENTE=

# Para onde a resposta VAI. É outro endereço de propósito: o subdomínio de
# envio não recebe, então responder ao remetente seria falar com o vazio.
#
# Fica em variável, e não no código, porque este endereço MUDA — hoje é um
# redirecionamento do registrador, amanhã é caixa própria. Trocar endereço não
# pode exigir alterar código e publicar de novo.
#
#   contato@fretigate.com   (domínio raiz, redirecionando para quem lê)
EMAIL_RESPOSTA=

# --- Aplicação -------------------------------------------------------------
# URL pública da aplicação. Em desenvolvimento, http://localhost:3000
#
# O Better Auth também usa esta variável como endereço base (`baseURL`), em vez
# de uma `BETTER_AUTH_URL` própria. Duas variáveis para o mesmo endereço só
# criam a chance de divergirem, e o dia em que divergirem o link de recuperação
# aponta para o lugar errado.
NEXT_PUBLIC_APP_URL=

# --- Checkout (Kiwify) -------------------------------------------------------
# Token de segurança do webhook (item 13) — configurado no painel da Kiwify,
# Apps > Webhooks, ao criar a integração. É o que prova que uma entrega em
# api/webhooks/kiwify veio mesmo da Kiwify: assinatura HMAC-SHA1 na
# querystring da URL (`?signature=`), com este token como chave — mecanismo
# confirmado contra a doc oficial e o FORMATO de uma entrega real, mas a
# fórmula em si (assinaturaValida, src/lib/servicos/verificacao-kiwify.ts)
# ainda não foi medida contra a querystring de uma entrega de verdade — ver
# docs/planos/corrige-webhook-kiwify.md e CLAUDE.md §14.
KIWIFY_WEBHOOK_TOKEN=

# Links de checkout dos dois planos (tela /planos, item 13, Tarefa 3) —
# copiados do painel da Kiwify. Não são segredo (qualquer um vê ao clicar em
# "Assinar"), mas ficam em variável porque o preço muda pelo painel da
# Kiwify, não pelo código.
KIWIFY_CHECKOUT_URL_MENSAL=
KIWIFY_CHECKOUT_URL_ANUAL=

# --- Autenticação (Better Auth) --------------------------------------------
# Segredo que assina o cookie de sessão e os tokens de recuperação de senha e
# de verificação de e-mail.
#
# Quem tem este valor consegue forjar uma sessão de qualquer usuário, de
# qualquer empresa — ele é o que sustenta a §3 acima do banco. Trocá-lo desloga
# todo mundo e invalida os links de recuperação em trânsito.
#
# UM POR AMBIENTE. O de produção nunca é o de desenvolvimento: se fossem o
# mesmo, um cookie assinado na máquina de quem programa valeria em produção.
#
# Para gerar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
