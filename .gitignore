# ---------------------------------------------------------------------------
# Dependencias
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build do Next.js
# ---------------------------------------------------------------------------
.next/
out/
build/
dist/
next-env.d.ts

# ---------------------------------------------------------------------------
# Segredos — regra 4 do CLAUDE.md: nenhum segredo no repositorio.
# Ignora todo .env, com excecao do .env.example (que nao contem valor real).
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Prisma
# As migrations SAO versionadas — elas sao o historico do banco.
# So o que a maquina gera fica de fora.
# ---------------------------------------------------------------------------
/prisma/generated/
/prisma/*.db
/prisma/*.db-journal
/prisma/migrations/dev.db*
/src/lib/generated/

# ---------------------------------------------------------------------------
# Testes e ferramentas
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
.eslintcache
*.tsbuildinfo

# ---------------------------------------------------------------------------
# gitleaks — a esteira baixa o binario na raiz do repositorio, sem commitar
# (.github/workflows/ci.yml). tests/varredura-de-segredo.test.ts procura o
# mesmo binario aqui para rodar localmente (CLAUDE.md §4).
# ---------------------------------------------------------------------------
/gitleaks
/gitleaks.exe
/gitleaks_*.tar.gz
/gitleaks_*.zip
/gitleaks_*_checksums.txt

# ---------------------------------------------------------------------------
# Hospedagem
# ---------------------------------------------------------------------------
.vercel/

# ---------------------------------------------------------------------------
# Cache de ferramentas locais
# ---------------------------------------------------------------------------
.turbo/
.cache/
.swc/
.parcel-cache/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Claude Code — gerado pela ferramenta de preview em cada maquina, nunca
# pelo projeto. .claude/agents e .claude/commands continuam versionados de
# proposito (definem o /revisar, o /onde-paramos etc. para todo mundo).
# ---------------------------------------------------------------------------
.claude/launch.json

# ---------------------------------------------------------------------------
# Sistema operacional e editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------------------------------------------------------------------------
# Arquivos de upload em desenvolvimento
# Comprovante e logo do cliente ficam no storage do provedor, nunca no repo.
# ---------------------------------------------------------------------------
/uploads/
/public/uploads/
/tmp/

# ---------------------------------------------------------------------------
# Material de referencia e marca: versiona o fonte, ignora o gerado.
# ---------------------------------------------------------------------------

# Pacote compactado. O Git nao compara o conteudo de um .zip — cada versao
# nova pesa inteira de novo no historico.
*.zip

# Bundles exportados do prototipo: trazem CSS, JS e imagem embutidos no
# proprio arquivo, com centenas de KB ou mais. O fonte de cada tela e o
# .dc.html correspondente, que continua versionado.
*(offline).html
*(standalone).html

# Arquivo de trabalho do Photoshop. Continua na pasta referencia/marca/ no
# disco, fora do controle de versao: o Git nao compara PSD, entao cada
# alteracao salva gravaria o arquivo inteiro de novo no historico, para sempre.
# Os .png exportados ficam versionados: sao a origem da marca. O que o app
# carrega e a copia em /public/marca/ (ver referencia/LEIA-ME.md).
*.psd

# Miniatura gerada pela ferramenta do prototipo.
.thumbnail

# Versao empacotada da folha de estilo. A fonte de verdade e docs/estilo.md
# (e docs/estilo.html), ambos versionados. Fonte de verdade unica.
FretiGate - Folha de estilo.html

# Rascunho e versao antiga da marca.
# ATENCAO: a lista e por nome de pasta. Pasta nova de rascunho dentro de
# referencia/marca/ que nao use um destes nomes entra no repositorio.
/referencia/marca/**/_old/
/referencia/marca/**/_rascunho/
/referencia/marca/**/rascunho/
/referencia/marca/**/antigo/
/referencia/marca/**/antigos/
/referencia/marca/**/old/
