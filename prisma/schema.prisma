// Schema do FretiGate.
//
// As URLs de conexão NÃO ficam aqui. A partir do Prisma 7 elas moram em
// `prisma.config.ts`, na raiz — é lá que está a explicação das duas.
//
// ATENÇÃO — O PRISMA NÃO MODELA RLS. `empresa` e `usuario` têm Row-Level
// Security ativada e forçada, com política de falha fechada, e isso vive em SQL
// dentro das migrations, não aqui. Tabela nova com `empresa_id` precisa de
// `ENABLE`, `FORCE`, política e `GRANT` **no mesmo commit** (`CLAUDE.md` §3).
// Este arquivo não avisa quando você esquece — o teste da tarefa 6 avisa.
//
// ATENÇÃO 2 — enquanto `DATABASE_URL` apontar para o papel `postgres`, a
// política não vale nada: esse papel ignora RLS. Ver `docs/diario.md`.

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"

  // Faz o cliente gerado importar os próprios arquivos com a extensão `.ts`
  // escrita. Sem isto o Node puro não consegue carregá-lo — só o empacotador do
  // Next.js e o do vitest, que adivinham a extensão sozinhos.
  //
  // Quem precisa disso é a seed de municípios (`prisma/seed/municipios.mts`),
  // que roda por fora do site, como comando de terminal. A alternativa era
  // instalar mais uma ferramenta só para executar um arquivo; esta linha faz o
  // mesmo com zero dependência nova.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Domínio — em português (CLAUDE.md §7), sem acento, nomes de tabela e coluna
// em minúsculo com underscore. Minúsculo importa: as políticas de RLS da
// tarefa 4 são SQL escrito à mão, e identificador em maiúsculo obrigaria aspas
// em toda linha, que é onde o erro de digitação se esconde.
// ---------------------------------------------------------------------------

/// A transportadora. É a raiz do isolamento: todo dado de domínio aponta para
/// uma Empresa, e nenhuma consulta roda sem filtrar por ela (§3).
model Empresa {
  id String @id @default(uuid(7)) @db.Uuid

  nome_fantasia String
  razao_social  String?

  /// Único no produto inteiro, **arquivadas incluídas**. É trava anti-abuso:
  /// sem isso, dá para abrir várias contas gratuitas e driblar o limite de 1
  /// caminhão (§10). Índice parcial por `arquivado_em` reabriria o buraco —
  /// bastaria arquivar e cadastrar de novo. Quem volta desarquiva a linha que
  /// já existe, que é o que o §7 manda.
  ///
  /// Nulo é permitido e não colide: o CNPJ é preenchido depois, na Conta da
  /// empresa. Guardar `''` em vez de nulo QUEBRA isso — duas contas vazias
  /// colidiriam. Grave nulo.
  ///
  /// Guardado **só com letra e número, maiúsculo, sem pontuação** — nunca só
  /// dígito. Desde 31/07/2026 a Receita emite CNPJ alfanumérico para
  /// inscrição nova: as 12 primeiras posições podem ter letra (A-Z), os 2
  /// dígitos verificadores finais continuam só número. `12.345.678/0001-90`
  /// e `12345678000190` têm que normalizar para o mesmo valor, senão a trava
  /// não vale nada — e "só dígito" recusaria CNPJ alfanumérico válido. O
  /// formato é garantido também no banco, pela restrição
  /// `empresa_cnpj_formato`.
  ///
  /// O CPF (`Cliente.documento`, `Motorista.documento`) não muda: continua
  /// só numérico, 11 dígitos — a mudança da Receita é só no CNPJ.
  cnpj String? @unique

  telefone String?
  email    String?
  endereco String?

  /// Referência ao município, com chave estrangeira desde o item 2.
  municipio_id Int?
  municipio    Municipio? @relation(fields: [municipio_id], references: [codigo_ibge], onDelete: Restrict)

  logo_url String?

  plano PlanoEmpresa @default(gratuito)

  /// Nulo no gratuito. Existe separado do plano porque é preciso saber quem
  /// está no mensal para oferecer o anual, e para a comissão do afiliado.
  periodicidade PeriodicidadePlano?

  status_assinatura StatusAssinatura @default(ativa)

  /// Topo dos três níveis de prazo de pagamento — empresa → cliente → edição
  /// ao faturar (`docs/especificacao.md` §4.7). É dele que
  /// `Cliente.prazo_pagamento_dias` vazio herda.
  ///
  /// Obrigatório (nunca nulo): "vazio" já tem significado no nível do
  /// cliente ("herda daqui"), então este nível não pode repetir o mesmo
  /// vazio sem apontar para lugar nenhum.
  ///
  /// A coluna entra aqui, no item 2, antes da tela que a edita (item 10):
  /// o formulário e o perfil do cliente (também item 2) já precisam dizer
  /// "vazio usa o padrão da empresa (15 dias)".
  prazo_padrao_dias Int @default(15)

  /// §11 — a única pergunta declarada do produto, mais a origem por primeiro
  /// toque. Nenhum outro campo de pesquisa existe em lugar nenhum.
  origem_cadastro  String?
  origem_declarada String?

  /// Obrigatórios de propósito: o aceite acontece no cadastro, então não
  /// existe Empresa sem aceite. A regra fica no banco, não só na tela.
  termos_aceitos_em DateTime @db.Timestamptz(6)
  termos_versao     String

  criado_em     DateTime  @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  /// §7 — nada é apagado. Preenchido = arquivado.
  arquivado_em  DateTime? @db.Timestamptz(6)

  usuarios       Usuario[]
  tipos_operacao TipoOperacao[]
  clientes       Cliente[]
  veiculos       Veiculo[]
  motoristas     Motorista[]

  @@map("empresa")
}

enum PlanoEmpresa {
  gratuito
  pago

  @@map("plano_empresa")
}

enum PeriodicidadePlano {
  mensal
  anual

  @@map("periodicidade_plano")
}

/// O acesso muda por estado, e a diferença entre `inadimplente` e `vencida` é
/// deliberada: bloquear no primeiro empurra para fora quem não escolheu sair.
///
/// - `ativa`         acesso completo
/// - `inadimplente`  pagamento falhou, em retentativa. Acesso continua
///                   liberado, com aviso para atualizar a forma de pagamento
/// - `vencida`       retentativa esgotada. Escrita bloqueada; leitura e
///                   exportação mantidas por 90 dias (§10)
/// - `encerrada`     passados os 90 dias
///
/// Nome do tipo diferente do nome da coluna de propósito: as políticas e
/// restrições são SQL escrito à mão, e tipo e coluna com o mesmo nome é
/// confusão gratuita na hora de ler.
enum StatusAssinatura {
  ativa
  inadimplente
  vencida
  encerrada

  @@map("status_assinatura_empresa")
}

enum PapelUsuario {
  dono
  operador

  @@map("papel_usuario")
}

/// Quem entra no sistema. É também a tabela `user` do Better Auth — os campos
/// da biblioteca ganham nome em português aqui, e a configuração do Better
/// Auth (tarefa 7) faz o mapeamento com `user.fields`. O motorista NÃO tem
/// acesso ao sistema (§12); esta tabela é só do dono e dos operadores.
///
/// NÃO tem `senha_hash`: o Better Auth guarda o hash na tabela `account`, com
/// o provedor `credential`. O §4 continua atendido — hash forte, nunca
/// reversível, nunca em log.
model Usuario {
  /// Texto, não uuid: o Better Auth gera este identificador com o formato
  /// dele. Quem manda no formato é a biblioteca que escreve a linha.
  id String @id

  nome  String
  email String @unique

  /// `emailVerified` do Better Auth.
  email_verificado Boolean @default(false)

  /// `image` do Better Auth.
  avatar_url String?

  papel            PapelUsuario
  ultimo_acesso_em DateTime?    @db.Timestamptz(6)

  /// uuid, e não texto, porque é esta coluna que a política de RLS compara com
  /// `nullif(current_setting('app.empresa_id', true), '')::uuid` (§9).
  empresa_id String  @db.Uuid
  empresa    Empresa @relation(fields: [empresa_id], references: [id], onDelete: Restrict)

  criado_em     DateTime  @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  arquivado_em  DateTime? @db.Timestamptz(6)

  sessions Session[]
  accounts Account[]

  @@index([empresa_id])
  @@map("usuario")
}

/// O que a `Servico` (item 3) aponta para. Existe para comportar guincho e
/// reboque sem reescrever nada depois (`CLAUDE.md` §9, "`Servico`, não
/// `Frete`") — o MVP entrega só a experiência de transportadora de carga
/// (`CLAUDE.md` §12), mas o modelo já nasce pronto para os outros ramos.
///
/// **`ativo` fica aqui**, e não contradiz `Veiculo`/`Motorista` não terem: ali
/// `ativo` seria a mesma coisa que arquivar. Aqui é outra coisa — **quais
/// ramos do produto estão ligados** para aquela empresa. É configuração de
/// escopo, não estado de registro do usuário, e por isso convive com
/// `arquivado_em` sem colidir: uma linha pode estar ativa (o ramo está ligado)
/// e mesmo assim vir a ser arquivada um dia (o registro deixou de existir).
///
/// **Toda empresa nasce com os quatro, na mesma transação que cria a
/// `Empresa`** — nunca num passo seguinte, senão uma falha no meio deixaria
/// empresa sem tipo nenhum, e o primeiro frete não teria o que escolher num
/// campo obrigatório. Quem cria é `src/lib/servicos/tipos-de-operacao.ts`,
/// chamado por `cadastro.ts` dentro do `emTransacao` que já cria a Empresa.
model TipoOperacao {
  id String @id @default(uuid(7)) @db.Uuid

  nome String
  /// Identificador estável para código e URL — "frete", "reboque",
  /// "guincho", "mudanca". Minúsculo e sem acento, como todo identificador
  /// (§7); `nome` é o que a tela mostra, `slug` é o que o código compara.
  slug String

  /// Só "Frete" nasce `true`. Os outros existem no modelo, desligados, até o
  /// MVP dar lugar ao ramo deles.
  ativo Boolean

  /// Posição de exibição — nas chips e no seletor, "Frete" sempre primeiro.
  ordem Int

  empresa_id String  @db.Uuid
  /// `Cascade`, e não `Restrict` como o resto do domínio: `TipoOperacao` nasce
  /// SEMPRE junto da `Empresa`, na mesma transação, então uma `Empresa` nunca
  /// existe por uma fração de segundo sem os quatro. Isso importa para
  /// `reverter_cadastro_incompleto` — ela apaga a `Empresa` órfã quando o
  /// passo 2 do cadastro falha, e com `Restrict` esse `DELETE` seria recusado
  /// pelos quatro `TipoOperacao` que já existem apontando para ela. `Cascade`
  /// aqui é seguro porque a garantia de nunca apagar `Empresa` com `Usuario`
  /// continua inteira dentro da função — o que muda é só o que acontece com
  /// as linhas que dependem da `Empresa` que ela decidiu apagar.
  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  criado_em     DateTime  @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  arquivado_em  DateTime? @db.Timestamptz(6)

  /// Único por empresa: a mesma empresa nunca tem "frete" duas vezes, mas
  /// "frete" existe em todas as empresas.
  @@unique([empresa_id, slug])
  @@index([empresa_id])
  @@map("tipo_operacao")
}

/// O cliente da transportadora — quem encomenda o frete. `docs/especificacao.md`
/// §6.
///
/// **Só `nome` é obrigatório.** Um cadastro rápido no meio do lançamento de
/// frete não pode travar em campo que ninguém tem à mão.
model Cliente {
  id String @id @default(uuid(7)) @db.Uuid

  nome String

  /// CPF ou CNPJ — o cliente da transportadora pode ser pessoa física ou
  /// jurídica. Mesma regra de formato de `Empresa.cnpj`: **guardado só com
  /// letra e número, maiúsculo, sem pontuação**, CNPJ podendo trazer letra
  /// nas 12 primeiras posições (formato alfanumérico da Receita) e CPF
  /// sempre 11 dígitos numéricos. **Guardar nulo, nunca `''`** — vazio
  /// colide com vazio, nulo não colide com nulo.
  ///
  /// Único por empresa quando preenchido, mas só entre os clientes **não
  /// arquivados**. Prisma não modela índice único parcial (a mesma limitação
  /// do comentário de RLS no topo deste arquivo) — a restrição
  /// `UNIQUE (empresa_id, documento) WHERE arquivado_em IS NULL` existe só
  /// na migration, não aqui. Duas diferenças da trava de `Empresa.cnpj`, e
  /// as duas têm motivo:
  ///
  ///   - **aqui o arquivamento libera o documento**; na Empresa, a trava é
  ///     anti-abuso e continua presa depois de arquivada. Aqui não há abuso
  ///     a evitar: cliente arquivado que a pessoa recadastra é o caso comum.
  ///   - **aqui é por empresa; na Empresa, é global** — o RLS já separa
  ///     duas empresas com o mesmo cliente cadastrado.
  documento String?

  telefone String?
  email    String?
  endereco String?

  municipio_id Int?
  municipio    Municipio? @relation(fields: [municipio_id], references: [codigo_ibge], onDelete: Restrict)

  /// Nulo = herda `Empresa.prazo_padrao_dias`. O nível do meio dos três da
  /// especificação §4.7 — empresa → cliente → edição ao faturar.
  prazo_pagamento_dias Int?

  observacao String?

  empresa_id String  @db.Uuid
  empresa    Empresa @relation(fields: [empresa_id], references: [id], onDelete: Restrict)

  criado_em     DateTime  @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  /// §7 — nada é apagado. Preenchido = arquivado, e é o que libera o
  /// `documento` para outro cadastro (ver acima).
  arquivado_em DateTime? @db.Timestamptz(6)

  @@index([empresa_id])
  @@map("cliente")
}

/// Cinco categorias de carroceria/porte, escolha única — `docs/especificacao.md`,
/// entidade Veiculo. Decisão do fundador, tarefa 6 (10/08/2026): três era pouco
/// (Bitruck é comum no segmento, Bitrem aparece em carga a granel no Nordeste) e
/// sete era demais (VUC/3-4 são entrega urbana, fora do público do produto).
/// Reexaminar no dia em que algo passar a consumir este campo — hoje não
/// alimenta cálculo, relatório, cobrança nem ordem.
enum TipoVeiculo {
  toco
  truck
  bitruck
  carreta
  bitrem

  @@map("tipo_veiculo")
}

/// O caminhão da transportadora. `docs/especificacao.md` §6.
///
/// **Só `apelido` ou `placa` é obrigatório** — quem só sabe a placa cadastra
/// pela placa. A garantia é dupla: a validação de entrada em
/// `src/lib/servicos/caminhoes.ts` recusa antes de chegar ao banco, e o `CHECK`
/// da migration recusa de novo, para quem gravar por fora do serviço (`/tests`,
/// `CLAUDE.md` §3) não abrir a mesma brecha.
///
/// **Não tem `ativo`** — mesmo motivo de `TipoOperacao` não valer aqui: ali
/// `ativo` é escopo de produto (quais ramos a empresa usa), aqui seria só uma
/// cópia de `arquivado_em` com outro nome. Dois mecanismos para "sumiu da
/// lista" divergem cedo ou tarde.
///
/// **Não tem `ano`** — existiu só em documento de tela desenhado antes do
/// formulário em si (`docs/especificacao.md`, entidade Veiculo): campo que só
/// existe em documento de tela é proposta, não decisão (`CLAUDE.md` §13).
model Veiculo {
  id String @id @default(uuid(7)) @db.Uuid

  placa   String?
  apelido String?
  tipo    TipoVeiculo?

  empresa_id String  @db.Uuid
  empresa    Empresa @relation(fields: [empresa_id], references: [id], onDelete: Restrict)

  /// Motoristas que têm este caminhão como habitual — lado inverso de
  /// `Motorista.veiculo_habitual`. Nunca lido direto (a leitura é sempre por
  /// `Motorista`), mas o Prisma exige o campo dos dois lados da relação.
  motoristas Motorista[]

  criado_em     DateTime  @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  /// §7 — nada é apagado. Preenchido = arquivado.
  arquivado_em DateTime? @db.Timestamptz(6)

  @@index([empresa_id])
  @@map("veiculo")
}

/// O motorista da transportadora. `docs/especificacao.md` §6.
///
/// **Só `nome` é obrigatório.** `documento` segue exatamente a mesma regra de
/// `Cliente.documento` (formato, normalização, unicidade parcial por empresa
/// entre os não arquivados) — ver o comentário lá, não repetido aqui.
///
/// **Não tem `ativo`** — mesmo motivo de `Veiculo`: arquivar já é o único
/// mecanismo de "sumiu da lista".
model Motorista {
  id String @id @default(uuid(7)) @db.Uuid

  nome String

  /// Mesma regra e mesma restrição de `Cliente.documento` — CPF ou CNPJ,
  /// normalizado sem pontuação, único por empresa só entre os não
  /// arquivados. `CLAUDE.md` §2: mesma regra, sem repetir a exceção do
  /// zero — o `CHECK`/índice da migration espelha
  /// `20260809060000_cliente_e_prazo_padrao` linha a linha.
  documento String?

  telefone String?

  /// Opcional. `CLAUDE.md` §3: RLS não cobre a checagem de chave estrangeira
  /// — `src/lib/servicos/motoristas.ts` confere que o caminhão pertence à
  /// mesma empresa antes de gravar aqui, e a conferência tem teste próprio.
  veiculo_habitual_id String?  @db.Uuid
  veiculo_habitual    Veiculo? @relation(fields: [veiculo_habitual_id], references: [id], onDelete: Restrict)

  empresa_id String  @db.Uuid
  empresa    Empresa @relation(fields: [empresa_id], references: [id], onDelete: Restrict)

  criado_em     DateTime  @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  /// §7 — nada é apagado. Preenchido = arquivado, e é o que libera o
  /// `documento` para outro cadastro (ver acima).
  arquivado_em DateTime? @db.Timestamptz(6)

  @@index([empresa_id])
  @@map("motorista")
}

/// Os 5.570 municípios do Brasil. **Tabela global de referência**, igual para
/// todas as empresas — não é dado do usuário, e ninguém do produto escreve nela.
///
/// DUAS EXCEÇÕES DECLARADAS, e as duas vêm da mesma natureza (§6 da
/// especificação, e `CLAUDE.md` §3):
///
///   - **não tem `empresa_id`**, porque não pertence a empresa nenhuma. Está
///     declarada com esse motivo em `tests/isolamento/schema.test.ts`, que
///     confere a lista por igualdade exata;
///   - **não tem `id` próprio**: a chave é o `codigo_ibge`, que é oficial,
///     estável há décadas e já é o que `Empresa.municipio_id` guarda. Criar um
///     `id` ao lado custaria mais que a exceção, e o custo não ficaria aqui:
///     todo lugar que guarda "o município" — empresa, cliente, origem e destino
///     do frete — teria que escolher qual dos dois guardar, e uns guardariam um
///     e outros o outro.
///
/// RLS ligada e forçada como em toda tabela, com a política `municipio_leitura`
/// — `USING (true) WITH CHECK (false)`, lê tudo e grava nada. As duas cláusulas
/// do §9 estão lá, sem exceção: a forma óbvia (`FOR SELECT USING (true)`) teria
/// pedido uma, porque política `FOR SELECT` não aceita `WITH CHECK`.
///
/// **A política recusa a escrita de todo papel sujeito a ela** — `fretigate_app`
/// e qualquer outro que venha. Ela **não** recusa a da conexão das migrations
/// (o papel `postgres`, que ignora RLS por atributo), e é por ela que a seed
/// (`prisma/seed/municipios.mts`) grava as 5.570 linhas. Isso é desenho:
/// `CLAUDE.md` §9 — nenhuma conexão que atende **pedido de usuário** ignora
/// RLS; comando de operação roda como `postgres`, igual a toda migration.
///
/// `fretigate_app` recebe **só `SELECT`**.
model Municipio {
  /// A chave. Sem `@default`: quem numera é o IBGE, não nós.
  codigo_ibge Int @id

  nome String
  /// Sigla de duas letras. As 27 unidades da federação.
  uf   String @db.Char(2)

  /// Minúsculo, sem acento e sem pontuação — escrito pela MESMA função que
  /// normaliza o que o usuário digita na busca (`normalizarParaBusca`, em
  /// `src/lib/utils/texto.ts`). É essa função única que garante que os dois
  /// lados casem; duas normalizações parecidas divergem no primeiro caso torto.
  ///
  /// É coluna, e não `unaccent()` na hora da consulta, porque `unaccent()` não
  /// usa índice — e a busca de município acontece **enquanto a pessoa digita**,
  /// dentro dos 30 segundos do §1.
  nome_normalizado String

  /// Coordenadas da SEDE do município (a praça central, para onde o caminhão
  /// vai), não do centro geométrico do território. Ver `prisma/seed/PROCEDENCIA.md`.
  ///
  /// `Float` (double precision), e isto não contradiz o §7: lá o que é proibido
  /// é dinheiro em decimal flutuante. Coordenada não é dinheiro — nunca é
  /// somada nem comparada por igualdade, só entra em cálculo de distância, que
  /// é ponto flutuante de qualquer jeito.
  latitude  Float
  longitude Float

  criado_em     DateTime  @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  /// Município extinto some da busca sem sumir do histórico (§7). A seed nunca
  /// toca nesta coluna: preencher é decisão, não efeito de recarregar a fonte.
  arquivado_em  DateTime? @db.Timestamptz(6)

  empresas Empresa[]
  clientes Cliente[]

  /// Índice de PREFIXO. `text_pattern_ops` é o que faz `nome_normalizado LIKE
  /// 'forta%'` usar índice; sem ele o Postgres varre as 5.570 linhas a cada
  /// tecla digitada.
  @@index([nome_normalizado(ops: raw("text_pattern_ops"))])
  @@map("municipio")
}

// ---------------------------------------------------------------------------
// Infraestrutura do Better Auth — nomes em inglês, iguais aos da biblioteca.
// Não são domínio: o §7 pede português para o que eu preciso conseguir ler, e
// renomear infraestrutura de biblioteca só cria atrito em toda atualização.
//
// Os campos abaixo saem de `@better-auth/core/dist/db/get-tables.mjs`, lidos do
// pacote instalado. Nenhum foi escrito de memória.
// ---------------------------------------------------------------------------

model Session {
  id String @id

  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  /// §4 diz que log não contém dado pessoal. Estes dois campos são do Better
  /// Auth e existem para o usuário poder encerrar sessão de outro aparelho.
  ipAddress String?
  userAgent String?

  userId String
  user   Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id String @id

  accountId  String
  providerId String

  userId String
  user   Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  /// O hash da senha vive aqui, não em `usuario`.
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id String @id

  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// A trava de tentativas do §4 — "rate limit em login, recuperação de senha e
/// toda rota que gere custo".
///
/// NÃO tem `empresa_id`, e não é esquecimento: a contagem acontece ANTES de
/// existir empresa. Quem tenta adivinhar senha não está logado, então não há
/// contexto de empresa para filtrar. A chave é o endereço de rede mais a rota,
/// montada pelo Better Auth. O teste de isolamento registra essa exceção pelo
/// nome, com este mesmo motivo.
///
/// Fica no banco, e não em memória, porque a Vercel roda várias instâncias: com
/// contagem em memória, cada instância teria a sua e o limite de 5 tentativas
/// viraria 5 vezes o número de instâncias. Trava que só vale numa instância não
/// é trava.
model RateLimit {
  id String @id

  /// Quem está sendo contado. Único porque a contagem é uma linha por chave —
  /// duas linhas para a mesma chave dividiriam o contador ao meio.
  key String @unique

  count Int

  /// Momento da última tentativa, em milissegundos. `BigInt` porque é assim que
  /// o Better Auth grava (`bigint: true` na definição da biblioteca), não por
  /// escolha nossa.
  lastRequest BigInt

  /// §7 — "toda tabela tem `criado_em` e `atualizado_em`", sem ressalva.
  ///
  /// O `lastRequest` acima marca tempo e seria tentador chamar de suficiente,
  /// mas ele é da biblioteca: mede a janela da trava, não a vida da linha. E
  /// abrir exceção numa regra absoluta enfraquece a regra — quem for
  /// acrescentar tabela depois vai achar a exceção antes de achar a regra.
  ///
  /// Não tem `arquivado_em`: "nada é apagado" vale para o domínio, e contador
  /// de tentativa vencido some mesmo — a própria biblioteca o apaga.
  criado_em     DateTime @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("rate_limit")
}
